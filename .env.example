# ─── Tarun Silks — environment variables ─────────────────────────────────────
# Copy to ".env" (local) or paste into Hostinger → Node.js app → Environment variables.
# Never commit the real .env. Names only here — no real values.

NODE_ENV=production
PORT=3000
PUBLIC_URL=https://www.your-domain.in
# Extra allowed origins for the API (comma separated). Leave empty for same-site only.
CORS_ORIGINS=

# MySQL (Hostinger hPanel → Databases → MySQL). Special characters in the password must be URL-encoded.
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME

# Where uploaded photos are stored. Use a folder OUTSIDE the deploy folder so redeploys never delete photos.
UPLOAD_DIR=/home/u123456789/tarun-uploads

# ── Admin access: these emails (signed in with Firebase) can open /admin
ADMIN_EMAILS=owner@your-domain.in,manager@your-domain.in

# ── Firebase (Console → Project settings)
# Web app config (public — shown to the browser)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_APP_ID=
# Service account (secret — Project settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private key on one line with \n for newlines, wrapped in double quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Razorpay (Dashboard → Account & Settings → API keys). Use rzp_test_ keys until launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → https://www.your-domain.in/api/webhooks/razorpay
# events: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Hostinger mail: smtp.hostinger.com, port 465)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=orders@your-domain.in
SMTP_PASS=
MAIL_FROM="Tarun Silks <orders@your-domain.in>"
# Gets a copy of every new order
ORDER_ALERT_EMAIL=owner@your-domain.in

# ── "Use my current location" reverse geocoding (optional — OpenStreetMap is used if both are empty)
OLA_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# ── Local development only (ignored when NODE_ENV=production): sign in with any email, no Firebase needed
DEV_AUTH_BYPASS=false
