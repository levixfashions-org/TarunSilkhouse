// Tarun Silks — database schema (MySQL on Hostinger)
// All money values are stored in paise (integers). ₹1,499 = 149900.

// Prisma 7 "client" engine: pure TypeScript + MariaDB/MySQL driver adapter.
// No native query-engine binary, so it runs on any Hostinger Node plan.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  COD_PENDING
  COD_COLLECTED
}

enum CouponType {
  PERCENT
  FLAT
  FREE_SHIPPING
}

enum ImageTag {
  MODEL
  DETAIL
  FLATLAY
  OTHER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id          String         @id @default(cuid())
  firebaseUid String         @unique
  email       String?        @unique
  phone       String?
  name        String?
  role        Role           @default(CUSTOMER)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  addresses   Address[]
  orders      Order[]
  wishlist    WishlistItem[]
  reviews     Review[]
  carts       Cart[]

  @@index([phone])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String   @db.VarChar(6)
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  kind      String    @default("fabric") // fabric | occasion | work
  image     String?
  sortOrder Int       @default(0)
  showInNav Boolean   @default(true)
  products  Product[]
}

model Product {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  description    String              @db.Text
  fabric         String
  weave          String?
  work           String? // zari | embroidery | printed | plain
  border         String?
  pallu          String?
  origin         String?
  care           String?             @db.Text
  occasions      Json // string[]
  lengthInfo     String              @default("Saree 5.5 m + blouse piece 0.8 m")
  blouseIncluded Boolean             @default(true)
  handloomMark   Boolean             @default(false)
  price          Int // paise
  mrp            Int // paise
  falloPicoPrice Int                 @default(0) // paise, 0 = not offered
  stitchingPrice Int                 @default(0) // paise, 0 = not offered
  isActive       Boolean             @default(true)
  isPinned       Boolean             @default(false)
  sortOrder      Int                 @default(0)
  popularity     Int                 @default(0)
  seoTitle       String?
  seoDescription String?
  categoryId     String?
  category       Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  colours        ProductColour[]
  images         ProductImage[]
  collections    CollectionProduct[]
  reviews        Review[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  stockAlerts    StockAlert[]
  cartItems      CartItem[]

  @@index([categoryId])
  @@index([createdAt])
  @@index([isActive, sortOrder])
}

model ProductColour {
  id         String         @id @default(cuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  colourName String
  hex        String         @db.VarChar(7)
  family     String? // red | green | gold | pink | blue | ... used by "shop by colour"
  stock      Int            @default(0)
  priceDelta Int            @default(0) // paise
  sortOrder  Int            @default(0)
  images     ProductImage[]
  orderItems OrderItem[]
  cartItems  CartItem[]
  alerts     StockAlert[]

  @@index([productId])
  @@index([family])
}

model ProductImage {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  colourId  String?
  colour    ProductColour? @relation(fields: [colourId], references: [id], onDelete: SetNull)
  url       String         @db.VarChar(1024) // may carry "#lx=x,y,zoom" framing
  alt       String?
  tag       ImageTag       @default(OTHER)
  sortOrder Int            @default(0)

  @@index([productId, sortOrder])
}

model Collection {
  id          String              @id @default(cuid())
  title       String
  handle      String              @unique
  description String?             @db.Text
  image       String?             @db.VarChar(1024)
  accent      String?             @db.VarChar(7)
  isRuleBased Boolean             @default(false)
  rules       Json? // { fabric?: string[], occasion?: string[], maxPrice?: number }
  showInNav   Boolean             @default(true)
  isEditorial Boolean             @default(false)
  sortOrder   Int                 @default(0)
  products    CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String? // for abandoned-bag reminders
  remindedAt DateTime?
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
  items     CartItem[]

  @@index([userId])
  @@index([updatedAt])
}

model CartItem {
  id        String        @id @default(cuid())
  cartId    String
  cart      Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  colourId  String
  colour    ProductColour @relation(fields: [colourId], references: [id], onDelete: Cascade)
  qty       Int
  options   Json? // { fallPico?: boolean, stitching?: {...} }
}

model Order {
  id             String             @id @default(cuid())
  number         String             @unique // TS-24001
  idempotencyKey String             @unique
  userId         String?
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  email          String
  phone          String
  status         OrderStatus        @default(PENDING_PAYMENT)
  paymentMethod  PaymentMethod
  subtotal       Int
  discount       Int                @default(0)
  shipping       Int                @default(0)
  codFee         Int                @default(0)
  giftWrap       Int                @default(0)
  tax            Int                @default(0) // GST included in price; stored for invoice
  total          Int
  couponCode     String?
  giftMessage    String?            @db.Text
  shipName       String
  shipLine1      String
  shipLine2      String?
  shipLandmark   String?
  shipCity       String
  shipState      String
  shipPincode    String             @db.VarChar(6)
  lat            Float?
  lng            Float?
  courier        String?
  awb            String?
  trackingUrl    String?            @db.VarChar(1024)
  notes          String?            @db.Text
  stockReleased  Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  items          OrderItem[]
  events         OrderStatusEvent[]
  payments       Payment[]

  @@index([phone])
  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  colourId    String?
  colour      ProductColour? @relation(fields: [colourId], references: [id], onDelete: SetNull)
  name        String
  colourName  String
  image       String?        @db.VarChar(1024)
  unitPrice   Int
  qty         Int
  servicesFee Int            @default(0)
  options     Json?
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method            PaymentMethod
  status            PaymentStatus
  amount            Int
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  refundedAmount    Int           @default(0)
  raw               Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Int // percent (1-100) or paise
  minCart     Int        @default(0)
  maxDiscount Int? // paise, for percent coupons
  usageLimit  Int?
  usedCount   Int        @default(0)
  perUser     Int?
  expiresAt   DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
}

model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String
  rating    Int
  title     String?
  body      String       @db.Text
  photos    Json? // string[]
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@unique([userId, productId, orderId])
  @@index([productId, status])
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model StockAlert {
  id         String         @id @default(cuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  colourId   String?
  colour     ProductColour? @relation(fields: [colourId], references: [id], onDelete: Cascade)
  email      String?
  phone      String?
  notifiedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([productId, colourId])
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String   @db.LongText // sanitized HTML
  seoTitle  String?
  updatedAt DateTime @updatedAt
}

model HomeSection {
  id        String  @id @default(cuid())
  type      String // hero | marquee | collections | story | pallu | colours | edits | new | bestsellers | testimonials | instagram | newsletter
  title     String?
  data      Json
  isVisible Boolean @default(true)
  sortOrder Int     @default(0)
}

model Setting {
  key   String @id
  value Json
}

model MediaFile {
  id        String   @id @default(cuid())
  key       String   @unique // storage key, e.g. 2026/11/abc123
  original  String   @db.VarChar(1024)
  thumb     String   @db.VarChar(1024)
  main      String   @db.VarChar(1024)
  zoom      String   @db.VarChar(1024)
  width     Int
  height    Int
  bytes     Int
  mime      String
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
