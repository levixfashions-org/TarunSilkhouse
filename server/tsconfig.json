{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitAny": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "outDir": "build",
    "types": ["node"]
  },
  "include": ["src", "prisma/seed.ts"]
}
